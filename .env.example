# ============================================================================
# NEWSUPERNOVA / OPENCLAW OMEGA — environment template
# ----------------------------------------------------------------------------
# Copy to `.env` (which is git-ignored) and fill in real values, OR set these
# in Render / Replit Secrets. NEVER commit real keys.
#
# In production these are pushed to Render via:
#   RENDER_API_KEY=... pnpm --filter @workspace/scripts run render:set-env
# ============================================================================

# ── Core (required for AI chat + browser tools) ─────────────────────────────
PORT=3000
NODE_ENV=development
# DATABASE_URL=postgres://user:pass@host:5432/db

# ── Operator auth + secrets vault ───────────────────────────────────────────
# OPERATOR_PASSWORD gates the admin UI / vault routes. SESSION_SECRET signs the
# operator login cookie.
# OPERATOR_PASSWORD=
# SESSION_SECRET=
#
# VAULT_KEY encrypts the in-app secrets vault (AES-256-GCM, scrypt-derived).
# Set this to a long random value and BACK IT UP — it is independent of
# SESSION_SECRET, so rotating your login secret will NOT destroy stored secrets.
# If VAULT_KEY is unset, the vault falls back to SESSION_SECRET (legacy behavior).
# Changing whichever key is in effect makes existing stored secrets undecryptable
# (they must be re-entered) — GET /api/integrations reports the orphaned count.
# VAULT_KEY=

# LLM provider — NVIDIA NIM (build.nvidia.com) is the swarm's ONLY LLM provider.
# Serves every agent model (Kimi K2.6, Nemotron, DeepSeek V4, Qwen 3.5, Mistral
# NIM builds, …). Without this key, all agent reasoning fails — there is no
# fallback provider. NIM_ENABLE_THINKING=on re-enables Nemotron reasoning traces
# (off by default for bounded latency). Add NVIDIA_API_KEY_2, _3, … to pool keys.
NVIDIA_API_KEY=
# NIM_ENABLE_THINKING=off

# Browser automation (Steel) + default web search (Firecrawl)
STEEL_API_KEY=
FIRECRAWL_API_KEY=

# ── Composio (authenticated SaaS/API tool router) ───────────────────────────
# Powers the composio_action agent tool. Execution stays OFF until you flip
# ALLOW_COMPOSIO_EXECUTE=true after connecting accounts in Composio.
COMPOSIO_API_KEY=
COMPOSIO_BASE_URL=https://backend.composio.dev/api/v3.1
ALLOW_COMPOSIO_EXECUTE=false

# ── Observability ───────────────────────────────────────────────────────────
# Helicone: when set, all NIM LLM traffic is transparently proxied through
# Helicone for logging/analytics.
HELICONE_API_KEY=

# LangSmith (a.k.a. LangChain) tracing for LLM runs.
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=openclaw-omega
# Optional overrides:
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# LANGSMITH_TRACING=true

# ── Web search providers ─────────────────────────────────────────────────────
# web_search fails over in order: SerpAPI → Tavily → Exa → Firecrawl → FreeCrawl
# (keyless DuckDuckGo backstop, always on). Set whichever keys you have; SerpAPI
# (real Google) runs FIRST when present — without it the swarm goes blind the
# moment the paid providers run out of credit. SERP_AI_API_KEY is accepted as an
# alias for SERP_API_KEY.
SERP_API_KEY=
TAVILY_API_KEY=
EXA_API_KEY=

# ── Semantic memory (real vector RAG for VAULT's memory_search) ──────────────
# Any OpenAI-compatible /embeddings endpoint. When unset, memory_search falls
# back to keyword matching.
EMBEDDINGS_API_KEY=
EMBEDDINGS_BASE_URL=https://api.openai.com/v1
EMBEDDINGS_MODEL=text-embedding-3-small

# ── Image generation (image_generate — combined multi-model router) ──────────
# ONE tool, several image models behind it with automatic fallback (same idea
# as web_search). Any OpenAI-compatible /images/generations endpoint that
# returns b64_json/url works. DeepInfra serves the whole menu (FLUX.2, Seedream,
# Google) under a single key, so usually you only set IMAGE_API_KEY.
#   IMAGE_API_KEY  — DeepInfra key (DEEPINFRA_API_KEY also accepted).
#   IMAGE_BASE_URL — OpenAI-compatible base (default DeepInfra, shown below).
#   IMAGE_MODELS   — ordered fallback chain, first = default. Optional; defaults
#                    to FLUX-2-pro → flash-image-2.5 → Seedream-5.0-Lite →
#                    FLUX-2-dev → FLUX-2-max. Agents can also pass
#                    model="text"/"budget"/"max"/<slug> to route a single job.
# With no key set, image_generate returns "not configured" (render_card still
# draws $0 text/quote/stat cards). A bare OPENAI_API_KEY falls back to gpt-image-1.
IMAGE_API_KEY=
# IMAGE_BASE_URL=https://api.deepinfra.com/v1/openai
# IMAGE_MODELS=black-forest-labs/FLUX-2-pro,google/flash-image-2.5,byteplus/Seedream-5.0-Lite,black-forest-labs/FLUX-2-dev

# ── Inngest (durable event bus) ─────────────────────────────────────────────
# INNGEST_EVENT_KEY is the trailing path segment of your ingest webhook URL:
#   https://inn.gs/e/<INNGEST_EVENT_KEY>
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# ── E2B (cloud code-interpreter sandbox; powers the cloud_code_exec tool) ────
# Requires the optional SDK: pnpm --filter @workspace/api-server add @e2b/code-interpreter
E2B_API_KEY=

# ── External inbound API (optional) ─────────────────────────────────────────
# If set, /api/external/v1/* requires this key (Bearer or x-api-key).
# OPENCLAW_API_KEY=

# ── Orchestrator solve loop ──────────────────────────────────────────────────
# Total solve budget per operator goal as a multiple of one single run: at
# most this many dispatch rounds INCLUDING the initial one, shared between the
# coordinator review loop and the solution gate. The swarm keeps cycling until
# the final briefing actually solves the input, or the budget runs out (the
# remaining gap is then reported honestly). Default: 4 (= 4x one single run).
# MAX_SOLVE_CYCLES=4

# ── Twin teaching sync (AURA ⇄ T800 master/learner link) ────────────────────
# Teacher side: after the nightly self-learning review, AURA pushes her
# VERIFIED lessons to the sibling swarm's POST /api/external/v1/twin-lessons
# (one-way teacher → learner; the receiver quarantines them as
# "from-twin,proposed"). No-op unless all three are set.
# TWIN_SYNC_ENABLED=true
# TWIN_API_URL=https://t800-aura.onrender.com
# TWIN_API_KEY=
# How far back to collect lessons for each push (default 6h, in ms):
# TWIN_SYNC_LOOKBACK_MS=21600000

# ── Primary/secondary collaboration relay (NEWSUPERNOVA ⇄ T800-AURA) ─────────────
# A live work loop between two swarms. The operator hands a goal to the PRIMARY
# (POST /api/relay). The primary runs its own cycle, forwards the output to the
# secondary's POST /api/external/v1/relay as input; the secondary analyses it as
# an independent swarm and replies. They ping-pong until the PRIMARY judges the
# MVP done or RELAY_MAX_ROUNDS is hit. No-op unless ENABLED + PEER_URL + API_KEY
# are all set. RELAY_API_KEY must equal the PEER's OPENCLAW_API_KEY.
# RELAY_ENABLED=true
# RELAY_ROLE=primary               # this deployment's role: primary | secondary (default secondary)
# RELAY_PEER_URL=https://t800-aura.onrender.com
# RELAY_API_KEY=                   # == the peer swarm's OPENCLAW_API_KEY
# RELAY_SELF_NAME=NEWSUPERNOVA
# RELAY_PEER_NAME=T800-AURA
# RELAY_MAX_ROUNDS=8               # hard cap on round-trips (1–50, default 8)
